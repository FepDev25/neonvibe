{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "qa_neonvibe": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.84",
          "--browser",
          "firefox",
          "--user-data-dir",
          "docs/qa/.browser",
          "--output-dir",
          "docs/qa/playwright",
          "--viewport-size",
          "1440x900",
          "--caps",
          "devtools",
          "--console-level",
          "warning",
          "--timeout-action",
          "10000",
          "--timeout-navigation",
          "60000",
          "--timeout-settle",
          "800"
        ],
        "cwd": ".",
        "codemode": false,
        "timeout": {
          "startup": 60000,
          "catalog": 60000
        }
      }
    }
  }
}
