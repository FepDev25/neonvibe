# NeonVibe — producción
# systemd: EnvironmentFile=/opt/neonvibe/neonvibe.env
#
# NOTA: deploy/setup.sh genera este archivo automáticamente con JWT_SECRET y
# DB_PASSWORD reales. Si lo creas a mano, genera los secrets:
#   openssl rand -base64 32    (JWT_SECRET)
# La app NO arranca en prod si JWT_SECRET es CHANGE_ME, vacío o <32 chars.

# --- Seguridad (OBLIGATORIO) ---
JWT_SECRET=CHANGE_ME

# --- PostgreSQL (OBLIGATORIO) ---
DB_URL=jdbc:postgresql://localhost:5432/neonvibe
DB_USERNAME=neonvibe
DB_PASSWORD=CHANGE_ME

# --- Dominio / orígenes (OBLIGATORIO) ---
# Orígenes CORS permitidos (lista separada por comas).
CORS_ALLOWED_ORIGINS=https://tudominio.com
# Patrón de origen permitido para WebSocket (patrón único).
WS_ORIGINS=https://tudominio.com
# URL base pública (usada en callbacks, p.ej. Last.fm).
FRONTEND_BASE=https://tudominio.com

# --- Login Google (OBLIGATORIO) ---
# Client ID de Google Cloud Console (OAuth 2.0 -> Web application). El backend
# verifica que el claim `aud` del id_token coincida: sin esto, un id_token
# emitido para CUALQUIER otra app de Google sería aceptado.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# Allowlist de cuentas autorizadas, separadas por coma. Obligatorio en prod:
# sin allowlist, cualquiera con cuenta de Google se registraría y accedería a
# toda la biblioteca. La app no arranca si está vacío.
ALLOWED_EMAILS=tu-correo@gmail.com

# --- Servidor ---
SERVER_PORT=8080
# Ruta(s) de la música (separadas por coma).
MUSIC_PATHS=/srv/Music
# 0 = solo detección en tiempo real / manual.
SCAN_INTERVAL=0

# --- Caches ---
COVERS_CACHE=/var/lib/neonvibe/covers
LYRICS_CACHE=/var/lib/neonvibe/lyrics

# --- Opcionales ---
# Scrobbling a Last.fm (crea una API account en last.fm/api):
# LASTFM_API_KEY=
# LASTFM_API_SECRET=
